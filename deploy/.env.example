# Copiar para deploy/.env na VPS (nunca vai para o Git) e preencher.

# Domínio da API (registro A apontando para o IP da VPS). O Caddy gera o HTTPS.
API_DOMAIN=api.suaagencia.com.br

# Supabase › Project Settings › Database › Connection string › "Session pooler".
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=no-verify
DATABASE_POOL_MAX=10

# Segredo longo e aleatório (ex.: openssl rand -hex 32).
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
PORT=3001

# Endereço do front no Netlify (CORS).
FRONTEND_URL=https://suaagencia.netlify.app

# Anexos no Supabase Storage (bucket privado "anexos").
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=anexos
FILES_MAX_MB=100
FILES_QUOTA_GB=

# Dono da conta, criado uma vez pelo seed (senha provisória, trocada no 1º acesso).
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=

# Assistente (Claude API). Vazio = assistente desligado. Chave em console.anthropic.com.
ANTHROPIC_API_KEY=
# Modelo (opcional; padrão claude-opus-5-5).
AI_MODEL=
