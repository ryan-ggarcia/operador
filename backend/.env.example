DATABASE_URL="postgresql://operador:operador@localhost:5432/operador"
# Conexões no pool do banco (opcional, padrão 10).
DATABASE_POOL_MAX=10
JWT_SECRET="troque-por-um-segredo-longo"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS=30
ANTHROPIC_API_KEY=""
PORT=3001
FRONTEND_URL="http://localhost:3000"
# Endereço público da API (links de download do storage local).
API_PUBLIC_URL="http://localhost:3001"

# Anexos. Com SUPABASE_URL, vão para o Supabase Storage (bucket privado);
# sem, para a pasta FILES_LOCAL_DIR (desenvolvimento).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="anexos"
FILES_LOCAL_DIR="storage"
# Tamanho máximo por arquivo (MB) e cota total da conta (GB; vazio = sem cota).
FILES_MAX_MB=100
FILES_QUOTA_GB=

# Dono da conta, criado pelo seed (npm run db:seed). A senha é provisória:
# o sistema pede a troca no primeiro acesso.
OWNER_EMAIL=""
OWNER_NAME=""
OWNER_PASSWORD=""
